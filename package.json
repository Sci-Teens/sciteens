{
  "name": "sciteens",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/copy-pdf-worker.js && node scripts/build-search-index.mjs && next dev",
    "build": "node scripts/copy-pdf-worker.js && node scripts/build-search-index.mjs && next build && next-sitemap",
    "start": "next start -p ${PORT:=3000}",
    "deploy": "",
    "lint": "next lint",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "pnpm test:unit && pnpm test:rules",
    "test:unit": "vitest run context lib components tests/pages tests/i18n scripts functions",
    "test:watch": "vitest context lib components tests/pages tests/i18n scripts functions",
    "test:rules": "firebase emulators:exec --project demo-sciteens-test --only firestore,storage \"vitest run tests/rules --no-file-parallelism\"",
    "backfill:images": "node scripts/backfill-optimize-images.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@next/third-parties": "^16.3.2",
    "@react-spring/web": "^9.7.5",
    "@tailwindcss/typography": "^0.5.15",
    "@tanstack/react-query": "^5.101.2",
    "@vercel/og": "^0.11.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression-webpack-plugin": "^12.0.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.17.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "i18next": "^26.3.6",
    "image-size": "^2.0.2",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^1.23.0",
    "moment": "^2.30.1",
    "next": "^15.5.22",
    "next-i18next": "^15.4.3",
    "pdfjs-dist": "^6.1.200",
    "playwright": "1.61.1",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^11.7.1",
    "react-hook-form": "^7.81.0",
    "react-i18next": "^17.0.11",
    "remark-directive": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "validator": "^13.15.35",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.23.0",
    "jsdom": "^29.1.1",
    "next-sitemap": "^1.9.12",
    "postcss": "^8.5.25",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.1.13",
    "shadcn": "^4.13.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "^1.1.17",
      "brace-expansion@2": "^2.1.3",
      "brace-expansion@5": "^5.0.8",
      "fast-uri": "^3.1.4",
      "fast-xml-parser": "^5.10.1",
      "postcss": "^8.5.25",
      "protobufjs": "^7.6.5",
      "sharp": "^0.35.3"
    }
  },
  "description": "This is the work-in-progress version of the open-source SciTeens platform. This application is built in Next JS (A Server-Side Rendered React JS framework.) If you encounter issues with the website, please fork our site and commit fixes or detail the issues in the issues tab on GitHub. If you just want to explore the code, then enjoy!",
  "main": ".eslintrc.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sci-Teens/sciteens.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Sci-Teens/sciteens/issues"
  },
  "homepage": "https://github.com/Sci-Teens/sciteens#readme"
}
