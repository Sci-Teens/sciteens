rules_version = '2';

// SciTeens Firestore Security Rules
//
// Enforcement model: the client performs only owner-scoped writes. Every
// mutation is gated on the authenticated user's uid and, where relevant,
// on documented ownership (member_uids for projects). Collections that
// are only written by Cloud Functions (newProgram, updateUserStats) are
// denied to clients entirely.

service cloud.firestore {
  match /databases/{database}/documents {

    // Shared by /profiles/{uid} and /projects/{projectId}: `links`
    // only gets a shape/size guard here (list, <= 10 entries) —
    // rules can't iterate a list to check each URL's host, so the
    // actual host allowlist is enforced at render time
    // (context/helpers.js#isAllowedLink), the same way `about`/
    // `abstract` are sanitized at render rather than in rules.
    function isValidLinks(data) {
      return !('links' in data)
        || (data.links is list && data.links.size() <= 10);
    }

    // Shared by every discussion subcollection so the three threads cannot
    // drift apart.
    function isValidNewComment() {
      return request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(
          ['date', 'uid', 'display', 'comment', 'reply_to_id', 'reply_to_name'])
        && request.resource.data.keys().hasAll(['date', 'uid', 'display', 'comment'])
        // `display` is the author name rendered next to every comment.
        // Pinned to the account's own token claim so one write cannot post
        // under another account's name. A user can still rename their own
        // account, so this is not an anti-impersonation control; a user
        // with no displayName sends null, which matches the absent claim.
        && request.resource.data.display == request.auth.token.get('name', null)
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.date is string
        // reply_to_id is interpolated into a Firestore document path in
        // newDiscussion (functions/index.js), so it is constrained to the
        // shape of a document id: a `/` in here retargets that read.
        && request.resource.data.get('reply_to_id', '') is string
        && request.resource.data.get('reply_to_id', '').matches('^[A-Za-z0-9]*$')
        && request.resource.data.get('reply_to_id', '').size() <= 128
        && request.resource.data.get('reply_to_name', '') is string
        && request.resource.data.get('reply_to_name', '').size() <= 200;
    }

    // Editing may only touch the body. Without this the create-time
    // guards are a one-write speed bump: post a clean comment, then
    // rewrite `display` and `comment` to anything at all.
    function isCommentBodyEdit() {
      return request.auth.uid == resource.data.uid
        && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['comment'])
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000;
    }

    // File URLs must stay in this Firebase project's bucket. The
    // client writes every record, so a matching contentType cannot
    // make an external GCS object trusted.
    function isStorageUrl(url) {
      return url is string
        && url.size() <= 2000
        && (
          url.matches(
            'https://firebasestorage\\.googleapis\\.com/v0/b/directed-relic-266701\\.appspot\\.com/o/.*'
          )
          || url.matches(
            'https://storage\\.googleapis\\.com/directed-relic-266701\\.appspot\\.com/.*'
          )
          || url.matches(
            'https://directed-relic-266701\\.firebasestorage\\.app/.*'
          )
        );
    }

    // Shape guard for the Firestore record written alongside every
    // Storage upload (context/helpers.js#buildFileRecord). `hasOnly`
    // rather than `hasAll` alone: the record is public-readable and
    // rendered, so an unknown extra key is an injection channel, and
    // contentType decides whether the client renders an <iframe>, an
    // <img>, or nothing at all.
    function isValidFileRecord(uploaderUid) {
      return request.resource.data.keys().hasOnly([
          'path', 'bucket', 'name', 'contentType', 'size', 'url',
          'uploadedBy', 'isPhoto', 'isResume', 'thumbnailUrl', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'path', 'bucket', 'name', 'contentType', 'size', 'url',
          'uploadedBy', 'isPhoto', 'createdAt'
        ])
        && request.resource.data.uploadedBy == uploaderUid
        && request.resource.data.bucket
            == 'directed-relic-266701.appspot.com'
        && isStorageUrl(request.resource.data.url)
        && (!('thumbnailUrl' in request.resource.data)
            || request.resource.data.thumbnailUrl == null
            || isStorageUrl(request.resource.data.thumbnailUrl))
        && request.resource.data.contentType in
            ['image/png', 'image/jpeg', 'image/jpg', 'application/pdf']
        && request.resource.data.size is int
        && request.resource.data.size >= 0
        && request.resource.data.size <= 8000000
        && request.resource.data.path is string
        && request.resource.data.bucket is string
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 255
        && request.resource.data.isPhoto is bool
        && request.resource.data.createdAt is string;
    }

    // ---- Profiles -------------------------------------------------------
    // Public-readable (shown on /profile/[slug]); writable only by owner.
    // create must include uid == auth.uid; update only requires ownership
    // (uid field already present from create).
    match /profiles/{uid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && isValidLinks(request.resource.data);
      allow update: if request.auth.uid == uid
        && isValidLinks(request.resource.data);
      allow delete: if request.auth.uid == uid;
    }

    // ---- Profile slugs --------------------------------------------------
    // { slug: <slug> }. Used by client to claim a unique slug during
    // signup. Authenticated users may create; no updates/deletes from
    // client (slug changes go through a Cloud Function or admin).
    match /profile-slugs/{slug} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ---- Emails ---------------------------------------------------------
    // uid -> email mapping. Owner may create their own row at signup
    // (the newUser Cloud Function also writes this, so the create is
    // idempotent). Never client-readable: leaks every user's email.
    match /emails/{uid} {
      allow read: if false;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.email is string;
      allow update, delete: if false;
    }

    // ---- Profile PII (private) ------------------------------------------
    // { race, gender, birthday } — collected at signup (pages/signup/*.js)
    // but never rendered on any page and never re-read by the client.
    // Split out of /profiles/{uid} (which is public-readable) so this
    // demographic/DOB data isn't exposed to anyone via a plain client
    // read; only the owner may read their own row. Write-once at create,
    // matching prior behavior where these fields were set once on the
    // public doc and never edited afterward.
    match /profiles-private/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['race', 'gender', 'birthday'])
        && request.resource.data.race is string
        && request.resource.data.gender is string
        && request.resource.data.birthday is string;
      allow update, delete: if false;
    }

    // ---- Profile pictures ----------------------------------------------
    // { picture: <url> }. Public-readable; owner or server writes.
    match /profile-pictures/{uid} {
      allow read: if true;
      allow create, update, delete: if request.auth.uid == uid;
    }

    // ---- Profile files --------------------------------------------------
    // One doc per Storage upload under profiles/{uid}/ (see
    // storage.rules and context/helpers.js#buildFileRecord) — the
    // record's id is always the Storage object's own basename. Reading
    // this collection replaces listing the Storage bucket directly.
    // Update is restricted to flipping `isPhoto`; every other field is
    // immutable once created (delete + recreate instead of editing a
    // path/bucket/contentType in place).
    match /profiles/{uid}/files/{fileId} {
      allow read: if true;
      allow create: if request.auth.uid == uid
        && isValidFileRecord(uid);
      allow update: if request.auth.uid == uid
        && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['isPhoto']);
      allow delete: if request.auth.uid == uid;
    }

    // ---- Projects -------------------------------------------------------
    // Public-readable. Any authenticated user may create one (they become
    // a member). Only existing members may update/delete. Mass-assignment
    // is constrained: client writes may not touch member_uids/subscribers
    // except to add the creator on create. `upvote_count` is denormalized
    // and may only move by +/-1 when paired with a write to
    // projects/{id}/upvotes/{uid} in the same transaction. `links`
    // validity is enforced by isValidLinks above (shared with
    // /profiles/{uid}).

    function isProjectMember(projectId) {
      return request.auth != null
        && request.auth.uid in
            get(/databases/$(database)/documents/projects/$(projectId))
              .data.member_uids;
    }

    function projectUpvoteCount(data) {
      return data.get('upvote_count', 0);
    }

    function isUpvoteCountOnlyUpdate() {
      return request.auth != null
        && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['upvote_count'])
        && request.resource.data.upvote_count is int
        && request.resource.data.upvote_count >= 0;
    }

    function isValidProjectCreator() {
      let profile = get(
        /databases/$(database)/documents/profiles/$(request.auth.uid)
      ).data;
      return request.resource.data.member_uids is list
        && request.resource.data.member_uids.size() == 1
        && request.resource.data.member_uids[0] == request.auth.uid
        && request.resource.data.member_arr is list
        && request.resource.data.member_arr.size() == 1
        && request.resource.data.member_arr[0].keys()
            .hasOnly(['uid', 'display', 'slug'])
        && request.resource.data.member_arr[0].uid == request.auth.uid
        && request.resource.data.member_arr[0].display == profile.display
        && request.resource.data.member_arr[0].slug == profile.slug;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create: if request.auth != null
        && isValidProjectCreator()
        && isValidLinks(request.resource.data)
        && (!('upvote_count' in request.resource.data)
            || request.resource.data.upvote_count == 0);
      allow update: if (
          (
            request.auth.uid in resource.data.member_uids
            && !request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasAny([
                  'member_uids',
                  'subscribers',
                  'upvote_count'
                ])
            && isValidLinks(request.resource.data)
          )
          || (
            isUpvoteCountOnlyUpdate()
            && (
              (
                request.resource.data.upvote_count
                  == projectUpvoteCount(resource.data) + 1
                && existsAfter(
                  /databases/$(database)/documents/projects/$(projectId)/upvotes/$(request.auth.uid)
                )
              )
              || (
                request.resource.data.upvote_count
                  == projectUpvoteCount(resource.data) - 1
                && exists(
                  /databases/$(database)/documents/projects/$(projectId)/upvotes/$(request.auth.uid)
                )
                && !existsAfter(
                  /databases/$(database)/documents/projects/$(projectId)/upvotes/$(request.auth.uid)
                )
              )
            )
          )
        );
      allow delete: if request.auth.uid in resource.data.member_uids;
      // ---- Project discussion ------------------------------------------
      match /discussion/{feedbackId} {
        allow read: if true;
        allow create: if
          exists(/databases/$(database)/documents/projects/$(projectId))
          && isValidNewComment();
        allow update: if isCommentBodyEdit();
        allow delete: if request.auth.uid == resource.data.uid;
      }

      // ---- Project files ------------------------------------------------
      // One doc per Storage upload under projects/{projectId}/ (see
      // storage.rules and context/helpers.js#buildFileRecord) — the
      // record's id is always the Storage object's own basename.
      // Update is restricted to flipping `isPhoto`.
      match /files/{fileId} {
        allow read: if true;
        allow create: if isProjectMember(projectId)
          && isValidFileRecord(request.auth.uid);
        allow update: if isProjectMember(projectId)
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['isPhoto']);
        allow delete: if isProjectMember(projectId);
      }

      // ---- Project upvotes ----------------------------------------------
      // One doc per supporter, doc id == auth.uid. Create/delete must be
      // paired with a matching +/-1 of the parent project's upvote_count
      // in the same transaction (see parent update rule).
      match /upvotes/{uid} {
        allow read: if true;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly([
            'uid',
            'projectId',
            'createdAt'
          ])
          && request.resource.data.uid == uid
          && request.resource.data.projectId == projectId
          && request.resource.data.createdAt is string
          && projectUpvoteCount(
                getAfter(
                  /databases/$(database)/documents/projects/$(projectId)
                ).data
             )
               == projectUpvoteCount(
                    get(
                      /databases/$(database)/documents/projects/$(projectId)
                    ).data
                  ) + 1;
        allow delete: if request.auth != null
          && request.auth.uid == uid
          && projectUpvoteCount(
                getAfter(
                  /databases/$(database)/documents/projects/$(projectId)
                ).data
             )
               == projectUpvoteCount(
                    get(
                      /databases/$(database)/documents/projects/$(projectId)
                    ).data
                  ) - 1
          && projectUpvoteCount(
                getAfter(
                  /databases/$(database)/documents/projects/$(projectId)
                ).data
             ) >= 0;
        allow update: if false;
      }
    }

    // ---- Project invites -----------------------------------------------
    // The server deletes each request after it reserves a global sender
    // quota. Clients cannot update or recycle an in-flight request.
    match /project-invites/{projectId} {
      allow read: if false;
      allow create: if
        exists(/databases/$(database)/documents/projects/$(projectId))
        && isProjectMember(projectId)
        && request.resource.data.keys()
            .hasOnly(['emails', 'title', 'requestedBy'])
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.emails is list
        && request.resource.data.emails.size() > 0
        && request.resource.data.emails.size() <= 10
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200;
      allow update, delete: if false;
    }

    // ---- Programs -------------------------------------------------------
    // Server-managed (newProgram / updateProgram / deleteProgram).
    match /programs/{programId} {
      allow read: if true;
      allow write: if false;
    }
    match /programs-minified/{programId} {
      allow read: if true;
      allow write: if false;
    }

    match /opportunities/{opportunityId} {
      allow read: if true;
      allow write: if false;
    }
    match /opportunity-sources/{sourceId} {
      allow read: if false;
      allow write: if false;
    }

    // ---- Courses --------------------------------------------------------
    // Enrollment records only. Course content moved to content/courses/*.md,
    // and the Prismic webhook that used to mirror names and dates in here is
    // gone, so nothing writes these docs any more. The public read went with
    // the content: what is left is `enrolled`, a roster of student uids, and
    // no client reads it. Slugs are public urls, so an open read here let
    // anyone enumerate who is in a course.
    match /courses/{slug} {
      allow read, write: if false;
    }

    // ---- Article and course discussion ----------------------------------
    // Singular names, matching the `type` each page hands
    // components/Discussion.js; `course` is not the `courses` collection
    // above. The parent document is never created because the slug is a
    // markdown filename.
    match /article/{slug}/discussion/{commentId} {
      allow read: if true;
      allow create: if isValidNewComment();
      allow update: if isCommentBodyEdit();
      allow delete: if request.auth.uid == resource.data.uid;
    }

    match /course/{slug}/discussion/{commentId} {
      allow read: if true;
      allow create: if isValidNewComment();
      allow update: if isCommentBodyEdit();
      allow delete: if request.auth.uid == resource.data.uid;
    }

    // ---- Statistics -----------------------------------------------------
    // Server-managed (updateUserStats).
    match /statistics/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Catch-all ------------------------------------------------------
    // Deny everything not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
